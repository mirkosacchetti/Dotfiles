# The eww daemon behind the bar (linux/eww). Started from sway
# (scripts/bar.sh), which then opens the windows; the service brings it back
# if it dies. WAYLAND_DISPLAY and SWAYSOCK reach it through the import that
# /etc/sway/config.d/50-systemd-user.conf does at sway start, so a start
# that comes too early just fails and is retried. PATH: the handlers and
# scripts the daemon runs need eww itself (~/.local/bin until the package
# is installed) and the usual tools.
[Unit]
Description=eww bar daemon
Wants=eww-bar.service

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env eww daemon --no-daemonize
Restart=on-failure
RestartSec=1
