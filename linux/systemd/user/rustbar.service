# The bar (~/Projects/rustbar, config in linux/rustbar): one window per
# output, follows hotplugs by itself. sway starts the service from its
# config, after importing its own sockets into the manager's environment,
# so the bar never races the session's startup; the service brings it
# back if it dies, and SIGTERM makes it close its listener scripts.
# PATH: the mouse commands need rustbar itself (~/.local/bin) and the
# usual tools.
[Unit]
Description=rustbar

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/rustbar
Restart=on-failure
RestartSec=1