; eww bar: the waybar one rebuilt, with popups below instead of drawers:
; hovering a module opens a popup under it. The popup window is a second,
; transparent line laid out like the bar itself (same modules, same widths,
; text invisible) with the hovered module's slot showing a card with its
; information, so the card sits right under its module, growing right on
; the left side and left on the right side. Nothing in the bar moves. The
; scripts are the ones waybar used; they print JSON with text, info and
; class; see scripts/.
;
;   scripts/bar.sh      opens the bar on every output (sway exec_always)
;   info                opened and closed by the modules (scripts/eww-hover.sh)

(defvar S "/home/m/Dotfiles/scripts")
(defvar hovered "")
(defvar hoverseq "")

;; ---- data ------------------------------------------------------------
(deflisten sway :initial '{"workspaces": [], "mode": "default", "title": ""}' "/home/m/Dotfiles/scripts/sway-state.sh")
(deflisten scratchpad :initial '{"text": "", "info": "", "class": ""}' "/home/m/Dotfiles/scripts/scratchpad.sh")
(defpoll notifications :interval "2s" :initial '{"text": "", "info": "", "class": ""}' "/home/m/Dotfiles/scripts/notify-ctl.sh status")
(deflisten mpris :initial '{"text": "", "info": "", "class": ""}' "/home/m/Dotfiles/scripts/mpris.sh status")
(defpoll recording :interval "2s" :initial "" "pgrep -x wf-recorder > /dev/null && echo ⏺ || true")
(deflisten audio :initial '{"sink": {"text": "", "info": ""}, "source": {"text": "", "info": ""}}' "/home/m/Dotfiles/scripts/audio.sh")
(deflisten display :initial '{"text": "", "info": "", "class": ""}' "/home/m/Dotfiles/scripts/display.sh")
(defpoll brightness :interval "300s" :initial '{"text": "", "info": ""}' "/home/m/Dotfiles/scripts/brightness.sh status")
(defpoll nightlight :interval "60s" :initial '{"text": "", "info": "", "class": ""}' "/home/m/Dotfiles/scripts/nightlight.sh status")
(defpoll bluetooth :interval "30s" :initial '{"text": "", "info": ""}' "/home/m/Dotfiles/scripts/bluetooth.sh status")
(defpoll network :interval "10s" :initial '{"text": "", "info": ""}' "/home/m/Dotfiles/scripts/network.sh")
(defpoll battery :interval "30s" :initial '{"text": "", "info": "", "class": ""}' "/home/m/Dotfiles/scripts/battery.sh")
(defpoll profile :interval "10s" :initial '{"text": "", "info": ""}' "/home/m/Dotfiles/scripts/power-profile.sh")
; multi-line texts come from the shell: yuck drops the backslash of a "\n"
(defpoll power-info :interval "60s" :initial "" "uptime -p | sed 's/^up /Uptime: /'; echo 'Click: menu'; echo 'Right: lock'")
(defpoll date-info :interval "60s" :initial "" "date +'%A %d %B %Y%nWeek %V, day %j'")
(defpoll launcher-info :interval "1h" :initial "" "echo 'Click: applications'; echo 'Middle: windows'; echo 'Right: close the workspace'")

;; ---- one module, in the bar or in the info line ------------------------
;; mode "bar": the text, with the mouse actions; hovering names the module
;; and opens the popup line. mode "info": the same text, transparent, to
;; keep the slot's width, or the card (bold title, info lines) when this is
;; the hovered module.
(defwidget mod [name title text info screen ?class ?markup ?onclick ?onmiddle ?onright ?onscroll ?mode]
  (eventbox :class "module ${class ?: ""} ${hovered == name ? "open" : ""}"
            :visible {text != ""}
            :timeout "2s"
            :onhover {mode == "info" ? "" : "${S}/eww-hover.sh enter ${name} ${screen}"}
            :onhoverlost {mode == "info" ? "" : "${S}/eww-hover.sh leave ${screen}"}
            :onclick {onclick ?: ""} :onmiddleclick {onmiddle ?: ""} :onrightclick {onright ?: ""} :onscroll {onscroll ?: ""}
    (box :class "slot" :space-evenly false
      (label :class "ghost" :visible {(mode == "info") && (hovered != name)} :text text)
      (box :class "card" :orientation "v" :space-evenly false :visible {(mode == "info") && (hovered == name)}
        (label :class "card-title" :halign "start" :text title)
        (label :halign "start" :xalign 0 :visible {!(markup ?: false)} :text info)
        (label :halign "start" :xalign 0 :visible {markup ?: false} :markup info))
      (label :visible {(mode != "info") && !(markup ?: false)} :text text)
      (label :visible {(mode != "info") && (markup ?: false)} :markup text))))


(defwidget left [mode screen]
  (box :class "left" :orientation "h" :space-evenly false :spacing 2 :halign "start"
    (box :class "workspaces" :space-evenly false
      (for ws in {sway.workspaces}
        (button :class "ws ${ws.focused ? "focused" : ""} ${ws.urgent ? "urgent" : ""} ${mode == "info" ? "ghost" : ""}"
                :onclick "swaymsg workspace '${ws.name}'" "${ws.name}")))
    (mod :name "scratchpad" :title "Scratchpad" :mode mode :screen screen :text {scratchpad.text} :info {scratchpad.info} :class {scratchpad.class}
         :onclick "${S}/scratchpad-ctl.sh toggle" :onmiddle "${S}/scratchpad-ctl.sh move" :onright "${S}/scratchpad-ctl.sh close"
         :onscroll "[ {} = up ] && ${S}/scratchpad-ctl.sh prev || ${S}/scratchpad-ctl.sh next")
    (label :class "mode ${mode == "info" ? "ghost" : ""}" :visible {sway.mode != "default"} :text {sway.mode})
    (mod :name "launcher" :title "Launcher" :mode mode :screen screen :text "󰕰" :info launcher-info
         :onclick "pkill -x fuzzel || ${S}/launcher.sh" :onmiddle "pkill -x fuzzel || ${S}/window-switcher.sh"
         :onright "swaymsg '[workspace=__focused__] kill'")
    (mod :name "notifications" :title "Notifications" :mode mode :screen screen :text {notifications.text} :info {notifications.info} :class {notifications.class}
         :onclick "pkill -x fuzzel || ${S}/notify-ctl.sh pick" :onmiddle "${S}/notify-ctl.sh clear" :onright "${S}/notify-ctl.sh toggle")
    (box :class "tray" :visible {mode != "info"} (systray :icon-size 16 :spacing 4))
    (mod :name "title" :title "Window" :mode mode :screen screen :text "| ${substring(sway.title, 0, 60)}" :info {sway.title} :class "title"
         :onclick "${S}/float-toggle.sh" :onmiddle "swaymsg fullscreen toggle" :onright "swaymsg kill"
         :onscroll "[ {} = up ] && swaymsg focus prev || swaymsg focus next")))

(defwidget right [mode screen]
  (box :class "right" :orientation "h" :space-evenly false :spacing 2 :halign "end"
    (mod :name "mpris" :title "Player" :mode mode :screen screen :text {mpris.text} :info {mpris.info} :class {mpris.class} :markup true
         :onclick "playerctl play-pause" :onmiddle "playerctld shift" :onright "playerctl next"
         :onscroll "[ {} = up ] && ${S}/mpris.sh volume 5%+ || ${S}/mpris.sh volume 5%-")
    (mod :name "recording" :title "Recording" :mode mode :screen screen :text recording :info "wf-recorder is running" :class "recording" :onclick "${S}/record-toggle.sh")
    (mod :name "volume" :title "Audio output" :mode mode :screen screen :text {audio.sink.text} :info {audio.sink.info}
         :onclick "pavucontrol" :onmiddle "${S}/cycle.sh sink" :onright "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
         :onscroll "[ {} = up ] && wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+ || wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-")
    (mod :name "mic" :title "Audio input" :mode mode :screen screen :text {audio.source.text} :info {audio.source.info}
         :onclick "pavucontrol -t 4" :onmiddle "${S}/cycle.sh source" :onright "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
         :onscroll "[ {} = up ] && wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 2%+ || wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%-")
    (mod :name "display" :title "Display" :mode mode :screen screen :text {display.text} :info {display.info} :class {display.class}
         :onclick "nwg-displays" :onmiddle "${S}/display.sh next" :onright "${S}/display-restore.sh")
    (mod :name "brightness" :title "Brightness" :mode mode :screen screen :text {brightness.text} :info {brightness.info}
         :onmiddle "${S}/display.sh next"
         :onscroll "[ {} = up ] && ${S}/brightness.sh set 5%+ || ${S}/brightness.sh set 5%-")
    (mod :name "nightlight" :title "Night light" :mode mode :screen screen :text {nightlight.text} :info {nightlight.info} :onclick "${S}/nightlight.sh toggle")
    (mod :name "bluetooth" :title "Bluetooth" :mode mode :screen screen :text {bluetooth.text} :info {bluetooth.info}
         :onclick "blueman-manager" :onmiddle "${S}/bluetooth.sh next")
    (mod :name "network" :title "Network" :mode mode :screen screen :text {network.text} :info {network.info} :onclick "alacritty --class impala -e impala")
    (mod :name "battery" :title "Battery" :mode mode :screen screen :text {battery.text} :info {battery.info} :class {battery.class})
    (mod :name "profile" :title "Power profile" :mode mode :screen screen :text {profile.text} :info {profile.info} :onmiddle "${S}/cycle.sh power-profile")
    (mod :name "power" :title "Power" :mode mode :screen screen :text "⏻" :info power-info
         :onclick "pkill -x fuzzel || ${S}/power-menu.sh" :onright "swaylock")
    (mod :name "clock" :title "Date" :mode mode :screen screen :text {formattime(EWW_TIME, "%Y-%m-%d %H:%M")}
         :info date-info :onclick "/home/m/Projects/calendar/build/deca")))

(defwidget line [mode screen]
  (centerbox :class "line ${mode}" :orientation "h"
    (left :mode mode :screen screen)
    (box)
    (right :mode mode :screen screen)))

;; one per output, screen is its name: eww open bar --id bar-DP-7 --screen DP-7 --arg screen=DP-7
(defwindow bar [screen]
  :monitor screen
  :geometry (geometry :x "0" :y "0" :width "100%" :height "28px" :anchor "top center")
  :stacking "fg" :exclusive true :focusable false :namespace "eww-bar"
  (line :mode "bar" :screen screen))

;; not exclusive: under the bar, over the windows; as tall as its card
(defwindow info [screen]
  :monitor screen
  :geometry (geometry :x "0" :y "0" :width "100%" :anchor "top center")
  :stacking "overlay" :exclusive false :focusable false :namespace "eww-info"
  (line :mode "info" :screen screen))
