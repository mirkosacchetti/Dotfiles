; eww bar: the waybar one rebuilt, with popups below instead of drawers:
; hovering a module opens a popup under it. The popup window is a second,
; transparent line laid out like the bar itself (same modules, same widths,
; text invisible) with the hovered module's slot showing a card with its
; information, so the card sits right under its module, growing right on
; the left side and left on the right side. Nothing in the bar moves. The
; scripts are the ones waybar used; they print JSON with text, info and
; class; see scripts/.
;
;   scripts/bar.sh      opens the bar on every output (sway exec_always)
;   info                opened and closed by the modules (scripts/eww-hover.sh)

(defvar S "/home/m/Dotfiles/scripts")
(defvar hovered "")
(defvar hoverseq "")

;; ---- data ------------------------------------------------------------
;; deflisten scripts exec over the shell eww starts them in, so a reload
;; kills them instead of leaving them behind
(deflisten sway :initial '{"workspaces": [], "mode": "default", "title": ""}' "exec /home/m/Dotfiles/scripts/sway-state.sh")
(deflisten scratchpad :initial '{"text": "", "info": "", "class": ""}' "exec /home/m/Dotfiles/scripts/scratchpad.sh")
(defpoll notifications :interval "2s" :initial '{"text": "", "info": "", "class": ""}' "/home/m/Dotfiles/scripts/notify-ctl.sh status")
(deflisten mpris :initial '{"text": "", "info": "", "class": ""}' "exec /home/m/Dotfiles/scripts/mpris.sh status")
(defpoll recording :interval "2s" :initial "" "pgrep -x wf-recorder > /dev/null && echo ⏺ || true")
(deflisten audio :initial '{"sink": {"text": "", "info": ""}, "source": {"text": "", "info": ""}}' "exec /home/m/Dotfiles/scripts/audio.sh")
(deflisten display :initial '{"text": "", "info": "", "class": ""}' "exec /home/m/Dotfiles/scripts/display.sh")
(defpoll brightness :interval "300s" :initial '{"text": "", "info": ""}' "/home/m/Dotfiles/scripts/brightness.sh status")
(defpoll nightlight :interval "60s" :initial '{"text": "", "info": "", "class": ""}' "/home/m/Dotfiles/scripts/nightlight.sh status")
(defpoll bluetooth :interval "30s" :initial '{"text": "", "info": ""}' "/home/m/Dotfiles/scripts/bluetooth.sh status")
(defpoll network :interval "10s" :initial '{"text": "", "info": ""}' "/home/m/Dotfiles/scripts/network.sh")
(defpoll battery :interval "30s" :initial '{"text": "", "info": "", "class": ""}' "/home/m/Dotfiles/scripts/battery.sh")
(defpoll profile :interval "10s" :initial '{"text": "", "info": ""}' "/home/m/Dotfiles/scripts/power-profile.sh")
; multi-line texts come from the shell: yuck drops the backslash of a "\n"
(defpoll power-info :interval "60s" :initial "" "uptime -p | sed 's/^up /Uptime: /'")
(defpoll date-info :interval "60s" :initial "" "date +'%A %d %B %Y%nWeek %V, day %j'")

;; one mouse action: badge and text, a cell of the 2x2 table under the card;
;; an empty one (the arrays are padded to four) takes no room
(defwidget hint [h]
  (box :class "hint" :space-evenly false :halign "start" :visible {h[0] != ""}
    (label :class "key" :text {h[0]})
    (label :text {h[1]})))

;; ---- one module, in the bar or in the info line ------------------------
;; Every mouse command runs detached (setsid -f): eww kills a handler that
;; outlives its timeout, which would cut short a device cycle or a DDC
;; write, and would take down a program the click opened.
;; mode "bar": the text, with the mouse actions; hovering names the module
;; and opens the popup line. mode "info": the same text, transparent, to
;; keep the slot's width, or the card (bold title, info lines, then the
;; mouse actions, small, each with a badge for the button: L, M, R or the
;; wheel, with the button number, in a 2x2 table) when this is the hovered
;; module. The card has a fixed width
;; (style), long lines are cut with an ellipsis.
(defwidget mod [name title text info hints screen ?class ?markup ?onclick ?onmiddle ?onright ?onscroll ?mode]
  (eventbox :class "module ${class ?: ""} ${hovered == name ? "open" : ""}"
            :visible {text != ""}
            :timeout "2s"
            :onhover {mode == "info" ? "" : "${S}/eww-hover.sh enter ${name} ${screen}"}
            :onhoverlost {mode == "info" ? "" : "${S}/eww-hover.sh leave ${screen}"}
            :onclick {onclick ?: ""} :onmiddleclick {onmiddle ?: ""} :onrightclick {onright ?: ""} :onscroll {onscroll ?: ""}
    (box :class "slot" :space-evenly false
      (label :class "ghost" :visible {(mode == "info") && (hovered != name)} :text text)
      (box :class "card" :orientation "v" :space-evenly false :visible {(mode == "info") && (hovered == name)}
        (label :class "card-title" :halign "start" :text title)
        (label :halign "start" :xalign 0 :limit-width 40 :truncate true :visible {!(markup ?: false)} :text info)
        (label :halign "start" :xalign 0 :limit-width 40 :truncate true :visible {markup ?: false} :markup info)
        (box :class "hints" :orientation "v" :space-evenly false :visible {hints[0][0] != ""}
          (box :space-evenly false (hint :h {hints[0]}) (hint :h {hints[1]}))
          (box :space-evenly false :visible {hints[2][0] != ""} (hint :h {hints[2]}) (hint :h {hints[3]}))))
      (label :visible {(mode != "info") && !(markup ?: false)} :text text)
      (label :visible {(mode != "info") && (markup ?: false)} :markup text))))


(defwidget left [mode screen]
  (box :class "left" :orientation "h" :space-evenly false :spacing 2 :halign "start"
    (box :class "workspaces" :space-evenly false
      (for ws in {sway.workspaces}
        (button :class "ws ${ws.focused ? "focused" : ""} ${ws.urgent ? "urgent" : ""} ${mode == "info" ? "ghost" : ""}"
                :onclick "setsid -f swaymsg workspace '${ws.name}'" "${ws.name}")))
    (mod :name "scratchpad" :hints {[["L 1", "show / hide"], ["M 2", "move in / out"], ["R 3", "close"], ["⇅ 4/5", "previous / next"]]} :title "Scratchpad" :mode mode :screen screen :text {scratchpad.text} :info {scratchpad.info} :class {scratchpad.class}
         :onclick "setsid -f ${S}/scratchpad-ctl.sh toggle" :onmiddle "setsid -f ${S}/scratchpad-ctl.sh move" :onright "setsid -f ${S}/scratchpad-ctl.sh close"
         :onscroll "[ {} = up ] && setsid -f ${S}/scratchpad-ctl.sh prev || setsid -f ${S}/scratchpad-ctl.sh next")
    (label :class "mode ${mode == "info" ? "ghost" : ""}" :visible {sway.mode != "default"} :text {sway.mode})
    (mod :name "launcher" :hints {[["L 1", "applications"], ["M 2", "windows"], ["R 3", "close the workspace"], ["", ""]]} :title "Launcher" :mode mode :screen screen :text "󰕰" :info "fuzzel"
         :onclick "pkill -x fuzzel || setsid -f ${S}/launcher.sh" :onmiddle "pkill -x fuzzel || setsid -f ${S}/window-switcher.sh"
         :onright "setsid -f swaymsg '[workspace=__focused__] kill'")
    (mod :name "notifications" :hints {[["L 1", "history"], ["M 2", "clear"], ["R 3", "silence"], ["", ""]]} :title "Notifications" :mode mode :screen screen :text {notifications.text} :info {notifications.info} :class {notifications.class}
         :onclick "pkill -x fuzzel || setsid -f ${S}/notify-ctl.sh pick" :onmiddle "setsid -f ${S}/notify-ctl.sh clear" :onright "setsid -f ${S}/notify-ctl.sh toggle")
    (box :class "tray" :visible {mode != "info"} (systray :icon-size 16 :spacing 4))
    (mod :name "title" :hints {[["L 1", "float"], ["M 2", "fullscreen"], ["R 3", "close"], ["⇅ 4/5", "focus previous / next"]]} :title "Window" :mode mode :screen screen :text "| ${substring(sway.title, 0, 60)}" :info {sway.title} :class "title"
         :onclick "setsid -f ${S}/float-toggle.sh" :onmiddle "setsid -f swaymsg fullscreen toggle" :onright "setsid -f swaymsg kill"
         :onscroll "[ {} = up ] && setsid -f swaymsg focus prev || setsid -f swaymsg focus next")))

(defwidget right [mode screen]
  (box :class "right" :orientation "h" :space-evenly false :spacing 2 :halign "end"
    (mod :name "mpris" :hints {[["L 1", "play / pause"], ["M 2", "next player"], ["R 3", "next track"], ["⇅ 4/5", "volume"]]} :title "Player" :mode mode :screen screen :text {mpris.text} :info {mpris.info} :class {mpris.class} :markup true
         :onclick "setsid -f playerctl play-pause" :onmiddle "setsid -f playerctld shift" :onright "setsid -f playerctl next"
         :onscroll "[ {} = up ] && setsid -f ${S}/mpris.sh volume 5%+ || setsid -f ${S}/mpris.sh volume 5%-")
    (mod :name "recording" :hints {[["L 1", "stop"], ["", ""], ["", ""], ["", ""]]} :title "Recording" :mode mode :screen screen :text recording :info "wf-recorder is running" :class "recording" :onclick "setsid -f ${S}/record-toggle.sh")
    (mod :name "volume" :hints {[["L 1", "mixer"], ["M 2", "next output"], ["R 3", "mute"], ["⇅ 4/5", "volume"]]} :title "Audio output" :mode mode :screen screen :text {audio.sink.text} :info {audio.sink.info}
         :onclick "setsid -f pavucontrol" :onmiddle "setsid -f ${S}/cycle.sh sink" :onright "setsid -f wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
         :onscroll "[ {} = up ] && setsid -f wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+ || setsid -f wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-")
    (mod :name "mic" :hints {[["L 1", "mixer"], ["M 2", "next input"], ["R 3", "mute"], ["⇅ 4/5", "volume"]]} :title "Audio input" :mode mode :screen screen :text {audio.source.text} :info {audio.source.info}
         :onclick "setsid -f pavucontrol -t 4" :onmiddle "setsid -f ${S}/cycle.sh source" :onright "setsid -f wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
         :onscroll "[ {} = up ] && setsid -f wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 2%+ || setsid -f wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%-")
    (mod :name "display" :hints {[["L 1", "settings"], ["M 2", "next screen"], ["R 3", "restore modes"], ["", ""]]} :title "Display" :mode mode :screen screen :text {display.text} :info {display.info} :class {display.class}
         :onclick "setsid -f nwg-displays" :onmiddle "setsid -f ${S}/display.sh next" :onright "setsid -f ${S}/display-restore.sh")
    (mod :name "brightness" :hints {[["M 2", "next screen"], ["⇅ 4/5", "level"], ["", ""], ["", ""]]} :title "Brightness" :mode mode :screen screen :text {brightness.text} :info {brightness.info}
         :onmiddle "setsid -f ${S}/display.sh next"
         :onscroll "[ {} = up ] && setsid -f ${S}/brightness.sh set 5%+ || setsid -f ${S}/brightness.sh set 5%-")
    (mod :name "nightlight" :hints {[["L 1", "toggle"], ["", ""], ["", ""], ["", ""]]} :title "Night light" :mode mode :screen screen :text {nightlight.text} :info {nightlight.info} :onclick "setsid -f ${S}/nightlight.sh toggle")
    (mod :name "bluetooth" :hints {[["L 1", "manager"], ["M 2", "next device"], ["", ""], ["", ""]]} :title "Bluetooth" :mode mode :screen screen :text {bluetooth.text} :info {bluetooth.info}
         :onclick "setsid -f blueman-manager" :onmiddle "setsid -f ${S}/bluetooth.sh next")
    (mod :name "network" :hints {[["L 1", "impala"], ["", ""], ["", ""], ["", ""]]} :title "Network" :mode mode :screen screen :text {network.text} :info {network.info} :onclick "setsid -f alacritty --class impala -e impala")
    (mod :name "battery" :hints {[["", ""], ["", ""], ["", ""], ["", ""]]} :title "Battery" :mode mode :screen screen :text {battery.text} :info {battery.info} :class {battery.class})
    (mod :name "profile" :hints {[["M 2", "next profile"], ["", ""], ["", ""], ["", ""]]} :title "Power profile" :mode mode :screen screen :text {profile.text} :info {profile.info} :onmiddle "setsid -f ${S}/cycle.sh power-profile")
    (mod :name "power" :hints {[["L 1", "menu"], ["R 3", "lock"], ["", ""], ["", ""]]} :title "Power" :mode mode :screen screen :text "⏻" :info power-info
         :onclick "pkill -x fuzzel || setsid -f ${S}/power-menu.sh" :onright "setsid -f swaylock")
    (mod :name "clock" :hints {[["L 1", "calendar"], ["", ""], ["", ""], ["", ""]]} :title "Date" :mode mode :screen screen :text {formattime(EWW_TIME, "%Y-%m-%d %H:%M")}
         :info date-info :onclick "setsid -f /home/m/Projects/calendar/build/deca")))

(defwidget line [mode screen]
  (centerbox :class "line ${mode}" :orientation "h"
    (left :mode mode :screen screen)
    (box)
    (right :mode mode :screen screen)))

;; one per output, screen is its name: eww open bar --id bar-DP-7 --screen DP-7 --arg screen=DP-7
(defwindow bar [screen]
  :monitor screen
  :geometry (geometry :x "0" :y "0" :width "100%" :height "28px" :anchor "top center")
  :stacking "fg" :exclusive true :focusable false :namespace "eww-bar"
  (line :mode "bar" :screen screen))

;; not exclusive: under the bar, over the windows; as tall as its card
(defwindow info [screen]
  :monitor screen
  :geometry (geometry :x "0" :y "0" :width "100%" :anchor "top center")
  :stacking "overlay" :exclusive false :focusable false :namespace "eww-info"
  (line :mode "info" :screen screen))
