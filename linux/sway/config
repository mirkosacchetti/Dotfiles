# Default startup scripts: sync env vars with systemd/D-Bus for proper session integration
include /etc/sway/config.d/*
# Xwayland stays enabled: lightweight, and some apps (Steam, VLC) still need X11
# xwayland disable
set $mod Mod4
set $alt Mod1

floating_modifier $mod normal
tiling_drag disabled
focus_follows_mouse no
set $menu fuzzel
set $term alacritty
set $browser chromium

#output * bg /home/m/Dotfiles/images/Nighthawks_by_Edward_Hopper_1942.jpg fill
output * bg "#16242d" solid_color

###########  
### i/o
###########  
set $laptop_display "Lenovo Group Limited 0x414B Unknown"
set $laptop_keyboard "1:1:AT_Translated_Set_2_keyboard"
# check input/output names with: swaymsg -t get_inputs / get_outputs
input * {
    xkb_options compose:ralt,shift:both_capslock
}
input  $laptop_keyboard {
    xkb_options compose:ralt,shift:both_capslock,caps:ctrl_modifier,altwin:swap_alt_win
}
# Disable the ThinkPad red nipple
input "2:10:TPPS/2_Elan_TrackPoint" {
    pointer_accel -1
}
# Generic External display
output * {
    scale 2
}
# 14" notebook display
output $laptop_display {
    resolution 2880x1800@120.000Hz 
    scale 2
}
# 27" external displays
output "Dell Inc. DELL U2725QE GNM6C34" {
    resolution 3840x2160@120.000Hz 
    scale 1.5
    position 0 0
}
# 27" second vertical external displays
output "LG Electronics LG HDR 4K 0x00006D62" {
    resolution 3840x2160@60.000Hz 
    scale 1.5
    transform 90
}
# Clamshell: lid close keeps running with an external monitor (panel off),
# suspends standalone; logind lid handling is off (systemd/logind-lid.conf)
bindswitch --reload --locked lid:on exec /home/m/Dotfiles/scripts/lid-close.sh
bindswitch --reload --locked lid:off output $laptop_display enable

###########  
### system
###########  
# disable mouse/trakpad es. scrolling on tabbed layout
bindsym button4 nop
bindsym button5 nop
bindsym button6 nop
bindsym button7 nop  
bindsym $mod+Return exec $term
bindsym $mod+g exec $browser
bindsym $mod+space exec $menu
# omarchy-style app launches
bindsym $mod+shift+f exec nautilus
bindsym $mod+shift+n exec $term -e nvim
bindsym $mod+shift+o exec obsidian
bindsym $mod+shift+m exec spotify-launcher
# media key/syms
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.2
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86Display exec swaymsg output "eDP-1" toggle
# capture: region/full to clipboard, with Shift to ~/Pictures/screenshots instead
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym control+Print exec grim - | wl-copy
bindsym shift+Print exec mkdir -p ~/Pictures/screenshots && grim -g "$(slurp)" ~/Pictures/screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png && notify-send -u low "Screenshot" "Region saved to ~/Pictures/screenshots"
bindsym control+shift+Print exec mkdir -p ~/Pictures/screenshots && grim ~/Pictures/screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png && notify-send -u low "Screenshot" "Screen saved to ~/Pictures/screenshots"
bindsym $alt+Print exec /home/m/Dotfiles/scripts/screenshot-window.sh
bindsym $mod+shift+Print exec /home/m/Dotfiles/scripts/record-toggle.sh
bindsym $mod+Print exec /home/m/Dotfiles/scripts/qr-capture.sh
bindsym $mod+grave exec nautilus

###########
### workspaces
###########
set $ws_docs 4
set $ws_office 5
set $ws_stuff 6
set $ws_ai 7
set $ws_media 8
set $ws_mess 9
set $ws_main " 0 "

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace $ws_mess
bindsym $mod+0 workspace $ws_main
# navigate active workspaces
bindsym $mod+Tab workspace back_and_forth
bindgesture swipe:right workspace next
bindgesture swipe:left workspace prev
bindsym $mod+control+r reload

### right hand: edit and resize
bindsym $mod+q kill
bindsym $mod+w focus mode_toggle
bindsym $mod+e exec /home/m/Dotfiles/scripts/float-toggle.sh
bindsym $mod+r sticky toggle

bindsym $mod+a split vertical
bindsym $mod+s layout toggle splitv splith
bindsym $mod+d layout toggle stacking tabbed
bindsym $mod+f fullscreen toggle

bindsym $mod+z resize shrink width 10 px or 10 ppt
bindsym $mod+x resize shrink height 10 px or 10 ppt
bindsym $mod+c resize grow height 10 px or 10 ppt
bindsym $mod+v resize grow width 10 px or 10 ppt

### left hand: focus and moving
bindsym $mod+u focus prev
bindsym $mod+o focus parent
bindsym $mod+i focus child
bindsym $mod+p focus next

bindsym $mod+j focus left
bindsym $mod+control+j move left
bindsym $mod+k focus down
bindsym $mod+control+k move down
bindsym $mod+l focus up
bindsym $mod+control+l move up
bindsym $mod+semicolon focus right
bindsym $mod+control+semicolon move right

bindsym $mod+m focus output left
bindsym $mod+control+m move container to output left
bindsym $mod+comma workspace prev_on_output
bindsym $mod+control+comma move workspace prev
bindsym $mod+period workspace next_on_output
bindsym $mod+control+period move workspace next
bindsym $mod+slash focus output right
bindsym $mod+control+slash move workspace to output right


###########  
### containers
###########  
# move focused container 
bindsym $mod+control+1 move container to workspace number 1
bindsym $mod+control+2 move container to workspace number 2
bindsym $mod+control+3 move container to workspace number 3
bindsym $mod+control+4 move container to workspace number 4
bindsym $mod+control+5 move container to workspace number 5
bindsym $mod+control+6 move container to workspace number 6
bindsym $mod+control+7 move container to workspace number 7
bindsym $mod+control+8 move container to workspace number 8
bindsym $mod+control+9 move container to workspace $ws_mess
bindsym $mod+control+0 move container to workspace $ws_main

###########  
### windows
###########  
# assign window to a workspace with window criteria
# use swaymsg -t get_tree 
assign [app_id="betterbird"] workspace $ws_mess
assign [app_id="org.telegram.desktop"] workspace $ws_mess
assign [app_id="com.transmissionbt*"] workspace $ws_stuff
assign [app_id="Bitwarden"] workspace $ws_stuff
assign [app_id="beekeeper-studio"] workspace $ws_stuff
assign [app_id="sublime_merge"] workspace $ws_stuff
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="org.gnome.Calculator"] floating enable
# sushi file preview (space in nautilus)
for_window [app_id="org.gnome.NautilusPreviewer"] floating enable

###########  
### style
###########  
font pango:JetBrainsMono Nerd Font, bold 10
#gaps inner 2
#gaps outer 0
default_border none
default_floating_border normal
# Lumon palette (from Omarchy 4), keeping the original Nord-era variable names
set $black                #16242d
set $dark_gray            #1b2d40
set $gray                 #243d56
set $light_gray           #304860
set $darkest_white        #d6e2ee
# focused tab/titlebar: inverted foreground/background instead of Lumon's bright active-tab blue
set $darker_white         #d6e2ee
set $white                #f2fcff
set $teal                 #b4e4f6
set $off_blue             #6fb8e3
set $glacier              #8bc9eb
set $blue                 #5e95bc 
set $red                  #4d86b0
set $orange               #8bc9eb
set $yellow               #6fa4c9
set $green                #5e95bc
set $purple               #8bc9eb
#                          border           background      text            indicator       child_border
 client.focused            $black           $darker_white   $black          $darkest_white  $darkest_white
 client.focused_tab_title  $black           $darker_white   $black                          
 client.focused_inactive   $black           $black          $darkest_white  $darkest_white  $black
 client.unfocused          $black           $black          $darkest_white  $darkest_white  $darkest_white
 client.urgent             $black           $red            $black          $darkest_white  $darkest_white
 client.placeholder        $black           $black          $darkest_white  $darkest_white  $darkest_white
 client.background         $black                                                          

###########  
### bar
###########  
bar {
    swaybar_command /home/m/Dotfiles/scripts/bar-loop.sh
    mode dock
    hidden_state hide
    modifier none
}

###########  
### apps
###########  
exec dunst
exec chromium
exec betterbird
exec Telegram
# manual lock only; swayidle just powers displays off after 10 min idle
bindsym $mod+Escape exec swaylock
exec swayidle -w timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
# clipboard history (omarchy-style manager on Super+Ctrl+V); sensitive copies are skipped
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
bindsym $mod+control+v exec cliphist list | fuzzel --dmenu --lines 15 --width 60 | cliphist decode | wl-copy
# omarchy-style notification controls: dismiss / dismiss all / invoke / history replay / DND
bindsym $mod+shift+comma exec dunstctl close
bindsym $mod+shift+control+comma exec dunstctl close-all
bindsym $mod+alt+comma exec dunstctl action
bindsym $mod+shift+alt+comma exec dunstctl history-pop
bindsym $mod+control+alt+comma exec 'dunstctl set-paused toggle; pkill -RTMIN+2 waybar'

