
# GENERAL SETTINGS
# ----------------
set window-title-basename true
set statusbar-home-tilde  true
set recolor               true
# set selection-clipboard   clipboard
# set guioptions none
set selection-notification false
set statusbar-at-top true
set continuous-hist-save true

unmap h
unmap j
unmap k
unmap l
map j scroll left
map k scroll down
map l scroll up
map ; scroll right

# LAYOUT SETTINGS
# ---------------
set statusbar-h-padding 0
set statusbar-v-padding 0
set page-padding 0
set show-scrollbars     false

# LUMON THEME
# ----------
set notification-error-bg       "#16242d"
set notification-error-fg       "#4d86b0"
set notification-warning-bg     "#16242d"
set notification-warning-fg     "#8bc9eb"
set notification-bg             "#16242d"
set notification-fg             "#d6e2ee"

set completion-bg               "#16242d"
set completion-fg               "#d6e2ee"
set completion-group-bg         "#1b2d40"
set completion-group-fg         "#d6e2ee"
set completion-highlight-bg     "#6fb8e3"
set completion-highlight-fg     "#1b2d40"

set index-bg                    "#16242d"
set index-fg                    "#b4e4f6"
set index-active-bg             "#b4e4f6"
set index-active-fg             "#16242d"

set inputbar-bg                 "#16242d"
set inputbar-fg                 "#d6e2ee"

set statusbar-bg                "#16242d"
set statusbar-fg                "#d6e2ee"

set default-bg                  "#16242d"
set default-fg                  "#d6e2ee"
set render-loading              "true"
set render-loading-bg           "#16242d"
set render-loading-fg           "#243d56"

set recolor-lightcolor          "#16242d"
set recolor-darkcolor           "#f2fcff"

set highlight-color            "rgba(126, 136, 159, 0.2)"
set highlight-active-color     "rgba(126, 136, 159, 0.2)"

