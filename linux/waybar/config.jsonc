// -*- mode: jsonc -*-
{

    "height": 28,
    "spacing": 2,
    "ipc": true,
    "id": "bar-0",
    "modules-left": [
        "sway/workspaces",
        "custom/scratchpad",
        "sway/mode",
        "custom/launcher",
        "custom/notifications",
        "tray",
        "sway/window"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/mpris",
        "custom/recording",
        "wireplumber",
        "pulseaudio#mic",
        "custom/display",
        "backlight",
        "custom/nightlight",
        "bluetooth",
        "network",
        "battery",
        "power-profiles-daemon",
        "custom/power",
        "clock"
    ],
    // playerctld follows whichever player was used last; the script adds the
    // app's volume and the other players to the tooltip, see scripts/mpris.sh
    "custom/mpris": {
        "exec": "/home/m/Dotfiles/scripts/mpris.sh status",
        "return-type": "json",
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctld shift",
        "on-click-right": "playerctl next",
        "on-scroll-up": "/home/m/Dotfiles/scripts/mpris.sh volume 5%+",
        "on-scroll-down": "/home/m/Dotfiles/scripts/mpris.sh volume 5%-"
    },
    "sway/mode": {
        "format": "{}"
    },
    "sway/window": {
        "format": "| {title}",
        "max-length": 60,
        "tooltip": false,
        "on-click": "/home/m/Dotfiles/scripts/float-toggle.sh",
        "on-click-middle": "swaymsg fullscreen toggle",
        "on-click-right": "swaymsg kill",
        "on-scroll-up": "swaymsg focus prev",
        "on-scroll-down": "swaymsg focus next"
    },
    "custom/recording": {
        "exec": "pgrep -x wf-recorder >/dev/null && echo '{\"text\":\"⏺\",\"tooltip\":\"Recording\",\"class\":\"recording\"}' || echo '{\"text\":\"\"}'",
        "return-type": "json",
        "interval": "once",
        "signal": 3,
        "on-click": "/home/m/Dotfiles/scripts/record-toggle.sh",
        "tooltip": true
    },
    "custom/launcher": {
        "format": "󰕰",
        "tooltip": false,
        "on-click": "pkill -x fuzzel || /home/m/Dotfiles/scripts/launcher.sh",
        "on-click-middle": "pkill -x fuzzel || /home/m/Dotfiles/scripts/window-switcher.sh",
        "on-click-right": "swaymsg '[workspace=__focused__] kill'"
    },
    "custom/notifications": {
        "exec": "/home/m/Dotfiles/scripts/notify-ctl.sh status",
        "return-type": "json",
        "interval": 2,
        "signal": 2,
        "on-click": "pkill -x fuzzel || /home/m/Dotfiles/scripts/notify-ctl.sh pick",
        "on-click-right": "/home/m/Dotfiles/scripts/notify-ctl.sh toggle",
        "on-click-middle": "/home/m/Dotfiles/scripts/notify-ctl.sh clear",
        "tooltip": true
    },
    "custom/scratchpad": {
        "exec": "/home/m/Dotfiles/scripts/scratchpad.sh",
        "return-type": "json",
        "on-click": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh toggle",
        "on-click-middle": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh move",
        "on-click-right": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh close",
        "on-scroll-up": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh prev",
        "on-scroll-down": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh next"
    },
    "custom/display": {
        "exec": "/home/m/Dotfiles/scripts/display.sh",
        "return-type": "json",
        "on-click": "nwg-displays",
        "on-click-right": "/home/m/Dotfiles/scripts/display-restore.sh"
    },
    "custom/nightlight": {
        "exec": "/home/m/Dotfiles/scripts/nightlight.sh status",
        "return-type": "json",
        "interval": 60,
        "signal": 4,
        "on-click": "/home/m/Dotfiles/scripts/nightlight.sh toggle"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "",
        "format-half": "󰃟",
        "format-high": "󰃠",
        "format-full": "",
        // a state applies from its value up; the highest matching one wins
        "states": { "half": 51, "high": 76, "full": 100 },
        "tooltip-format": "Brightness: {percent}%",
        "scroll-step": 5
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂰",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{device_alias} (battery {device_battery_percentage}%)",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },
    "tray": { },
    "clock": {
        "on-click" : "/home/m/Projects/calendar/build/deca",
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "{:%A %d %B %Y, week %V, day %j}"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 1,
        "format": "{capacity}% {icon}",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "🖧",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr}",
        "tooltip-format-wifi": "IF: {ifname}\nID: {essid}\nSS: {signalStrength}% ({signaldBm} dBm, {frequency} GHz)\nIP: {ipaddr}/{cidr}\nGW: {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected",
        "on-click": "alacritty --class impala -e impala"
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon}  {format_source} {volume}%",
        "format-bluetooth-muted": " {icon}  {format_source}",
        "format-muted": "",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 2
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": "",
        "tooltip-format": "{source_desc}: {source_volume}%",
        "on-click": "pavucontrol -t 4",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%-"
    },
    "custom/power": {
        "exec": "echo ⏻; uptime -p",
        "interval": 60,
        "on-click": "pkill -x fuzzel || /home/m/Dotfiles/scripts/power-menu.sh",
        "on-click-right": "swaylock"
    },
    "custom/pomidore": {
        "exec": "/home/m/.local/bin/pomidore waybar",
        "interval": 1,
        "format": "{}",
        "return-type": "json",
        "on-click": "/home/m/.local/bin/pomidore pause",
        "on-click-right": "/home/m/.local/bin/pomidore stop",
        "tooltip": true
    }
}
