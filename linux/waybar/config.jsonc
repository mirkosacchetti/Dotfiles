// -*- mode: jsonc -*-
{

    "reload_style_on_change": true,
    "height": 28,
    "spacing": 2,
    "ipc": true,
    "id": "bar-0",
    "modules-left": [
        "custom/power",
        "battery",
        "power-profiles-daemon",
        "backlight",
        "network",
        "bluetooth",
        "wireplumber",
        "mpris",
        "custom/recording"
    ],
    "modules-center": [
        "clock",
        "custom/notifications",
        "tray"
    ],
    "modules-right": [
        "sway/window",
        "sway/mode",
        "sway/workspaces",
        "custom/scratchpad",
        "custom/launcher"
    ],
    "mpris": {
        // playerctld follows whichever player was used last (cmus, spotify,
        // a browser tab); its D-Bus name is activatable so the first call
        // starts it
        "player": "playerctld",
        "format": "{dynamic}",
        "format-paused": "<i>{dynamic}</i>",
        "format-stopped": "",
        "dynamic-order": ["artist", "title"],
        "dynamic-len": 50,
        "tooltip-format": "{player}: {artist} — {title}\n{album}  {position}/{length}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-"
    },
    "sway/mode": {
        "format": "{}"
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 60,
        "tooltip": false,
        "on-click": "/home/m/Dotfiles/scripts/float-toggle.sh",
        "on-click-middle": "swaymsg kill",
        "on-click-right": "swaymsg move scratchpad",
        "on-scroll-up": "swaymsg focus prev",
        "on-scroll-down": "swaymsg focus next"
    },
    "custom/recording": {
        "exec": "pgrep -x wf-recorder >/dev/null && echo '{\"text\":\"⏺\",\"tooltip\":\"Recording\",\"class\":\"recording\"}' || echo '{\"text\":\"\"}'",
        "return-type": "json",
        "interval": "once",
        "signal": 3,
        "on-click": "/home/m/Dotfiles/scripts/record-toggle.sh",
        "tooltip": true
    },
    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "pkill -x fuzzel || /home/m/Dotfiles/scripts/launcher.sh",
        "on-click-right": "pkill -x fuzzel || /home/m/Dotfiles/scripts/window-switcher.sh"
    },
    "custom/notifications": {
        "exec": "/home/m/Dotfiles/scripts/notify-ctl.sh status",
        "return-type": "json",
        "interval": 2,
        "signal": 2,
        "on-click": "pkill -x fuzzel || /home/m/Dotfiles/scripts/notify-ctl.sh pick",
        "on-click-right": "/home/m/Dotfiles/scripts/notify-ctl.sh toggle",
        "on-click-middle": "/home/m/Dotfiles/scripts/notify-ctl.sh clear",
        "tooltip": true
    },
    "custom/scratchpad": {
        "exec": "/home/m/Dotfiles/scripts/scratchpad.sh",
        "return-type": "json",
        "on-click": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh toggle",
        "on-scroll-up": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh prev",
        "on-scroll-down": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh next"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "tooltip-format": "{percent}%",
        "format-icons": ["", ""],
        "scroll-step": 2
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂰",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{device_alias} (battery {device_battery_percentage}%)",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },
    "tray": { },
    "clock": {
        "on-click" : "/home/m/Projects/calendar/build/deca",
        "format": "{:%Y-%m-%d %A %H:%M}",
        "locale": "it_IT.UTF-8",
        "tooltip": false
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 1,
        "format": "{capacity}% {icon}",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "🖧",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr}",
        "tooltip-format-wifi": "IF: {ifname}\nID: {essid}\nSS: {signalStrength}% ({signaldBm} dBm, {frequency} GHz)\nIP: {ipaddr}/{cidr}\nGW: {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected",
        "on-click": "alacritty --class impala -e impala"
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon}  {format_source} {volume}%",
        "format-bluetooth-muted": " {icon}  {format_source}",
        "format-muted": "",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 2
    },
    "custom/power": {
        "format" : "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "logout": "sway exit",
            "shutdown": "systemctl poweroff",
            "reboot": "systemctl reboot",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        }
    },
    "custom/pomidore": {
        "exec": "/home/m/.local/bin/pomidore waybar",
        "interval": 1,
        "format": "{}",
        "return-type": "json",
        "on-click": "/home/m/.local/bin/pomidore pause",
        "on-click-right": "/home/m/.local/bin/pomidore stop",
        "tooltip": true
    }
}
