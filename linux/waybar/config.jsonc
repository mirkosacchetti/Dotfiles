// -*- mode: jsonc -*-
{

    "height": 28,
    "spacing": 2,
    "ipc": true,
    "id": "bar-0",
    // No tooltips: GTK 3 shows them after a fixed half second. A module with
    // more to say leads a group with a drawer instead: what used to be its
    // tooltip is a second module (the "-info" ones, or a second instance of
    // the same builtin) that slides out to its right on hover, at once. The
    // #group suffix is the CSS class the groups share (style.css). Opening
    // shifts the leader left under the pointer, which often lands on the
    // info module: so that one answers to the same clicks and scrolls.
    "modules-left": [
        "sway/workspaces",
        "group/scratchpad#group",
        "sway/mode",
        "custom/launcher",
        "group/notifications#group",
        "tray",
        "sway/window"
    ],
    "modules-center": [],
    "modules-right": [
        "group/mpris#group",
        "group/volume#group",
        "group/mic#group",
        "group/display#group",
        "group/brightness#group",
        "group/nightlight#group",
        "group/bluetooth#group",
        "group/network#group",
        "group/battery#group",
        "group/power-profile#group",
        "group/power#group",
        "group/clock#group"
    ],

    "group/scratchpad#group":     { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["custom/scratchpad", "custom/scratchpad-info"] },
    "group/notifications#group":  { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["custom/notifications", "custom/notifications-info"] },
    "group/mpris#group":          { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["custom/mpris", "custom/mpris-info"] },
    "group/volume#group":         { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["wireplumber", "wireplumber#info"] },
    "group/mic#group":            { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["pulseaudio#mic", "pulseaudio#mic-info"] },
    "group/display#group":        { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["custom/display", "custom/display-info"] },
    "group/brightness#group":     { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["custom/brightness", "custom/brightness-info"] },
    "group/nightlight#group":     { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["custom/nightlight", "custom/nightlight-info"] },
    "group/bluetooth#group":      { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["bluetooth", "bluetooth#info"] },
    "group/network#group":        { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["network", "network#info"] },
    "group/battery#group":        { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["battery", "battery#info"] },
    "group/power-profile#group":  { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["power-profiles-daemon", "power-profiles-daemon#info"] },
    "group/power#group":          { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["custom/power", "custom/power-info"] },
    "group/clock#group":          { "orientation": "inherit", "drawer": { "transition-duration": 150 }, "modules": ["clock", "clock#info"] },

    // playerctld follows whichever player was used last; the drawer has the
    // album, the app's volume and the other players, see scripts/mpris.sh
    "custom/mpris": {
        "exec": "/home/m/Dotfiles/scripts/mpris.sh status",
        "return-type": "json",
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctld shift",
        "on-click-right": "playerctl next",
        "on-scroll-up": "/home/m/Dotfiles/scripts/mpris.sh volume 5%+",
        "on-scroll-down": "/home/m/Dotfiles/scripts/mpris.sh volume 5%-"
    },
    "custom/mpris-info": {
        "exec": "/home/m/Dotfiles/scripts/mpris.sh info",
        "return-type": "json",
        "interval": "once",
        "signal": 5,
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctld shift",
        "on-click-right": "playerctl next",
        "on-scroll-up": "/home/m/Dotfiles/scripts/mpris.sh volume 5%+",
        "on-scroll-down": "/home/m/Dotfiles/scripts/mpris.sh volume 5%-"
    },
    "sway/mode": {
        "format": "{}"
    },
    "sway/window": {
        "format": "| {title}",
        "max-length": 60,
        "tooltip": false,
        "on-click": "/home/m/Dotfiles/scripts/float-toggle.sh",
        "on-click-middle": "swaymsg fullscreen toggle",
        "on-click-right": "swaymsg kill",
        "on-scroll-up": "swaymsg focus prev",
        "on-scroll-down": "swaymsg focus next"
    },
    "custom/recording": {
        "exec": "pgrep -x wf-recorder >/dev/null && echo '{\"text\":\"⏺\",\"class\":\"recording\"}' || echo '{\"text\":\"\"}'",
        "return-type": "json",
        "interval": "once",
        "signal": 3,
        "on-click": "/home/m/Dotfiles/scripts/record-toggle.sh"
    },
    "custom/launcher": {
        "format": "󰕰",
        "on-click": "pkill -x fuzzel || /home/m/Dotfiles/scripts/launcher.sh",
        "on-click-middle": "pkill -x fuzzel || /home/m/Dotfiles/scripts/window-switcher.sh",
        "on-click-right": "swaymsg '[workspace=__focused__] kill'"
    },
    "custom/notifications": {
        "exec": "/home/m/Dotfiles/scripts/notify-ctl.sh status",
        "return-type": "json",
        "interval": 2,
        "signal": 2,
        "on-click": "pkill -x fuzzel || /home/m/Dotfiles/scripts/notify-ctl.sh pick",
        "on-click-right": "/home/m/Dotfiles/scripts/notify-ctl.sh toggle",
        "on-click-middle": "/home/m/Dotfiles/scripts/notify-ctl.sh clear"
    },
    "custom/notifications-info": {
        "exec": "/home/m/Dotfiles/scripts/notify-ctl.sh info",
        "return-type": "json",
        "interval": 2,
        "signal": 2,
        "escape": true,
        "on-click": "pkill -x fuzzel || /home/m/Dotfiles/scripts/notify-ctl.sh pick",
        "on-click-right": "/home/m/Dotfiles/scripts/notify-ctl.sh toggle",
        "on-click-middle": "/home/m/Dotfiles/scripts/notify-ctl.sh clear"
    },
    "custom/scratchpad": {
        "exec": "/home/m/Dotfiles/scripts/scratchpad.sh",
        "return-type": "json",
        "on-click": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh toggle",
        "on-click-middle": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh move",
        "on-click-right": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh close",
        "on-scroll-up": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh prev",
        "on-scroll-down": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh next"
    },
    "custom/scratchpad-info": {
        "exec": "/home/m/Dotfiles/scripts/scratchpad.sh info",
        "return-type": "json",
        "escape": true,
        "on-click": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh toggle",
        "on-click-middle": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh move",
        "on-click-right": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh close",
        "on-scroll-up": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh prev",
        "on-scroll-down": "/home/m/Dotfiles/scripts/scratchpad-ctl.sh next"
    },
    "custom/display": {
        "exec": "/home/m/Dotfiles/scripts/display.sh",
        "return-type": "json",
        "on-click": "nwg-displays",
        "on-click-middle": "/home/m/Dotfiles/scripts/display.sh next",
        "on-click-right": "/home/m/Dotfiles/scripts/display-restore.sh"
    },
    "custom/display-info": {
        "exec": "/home/m/Dotfiles/scripts/display.sh info",
        "return-type": "json",
        "escape": true,
        "on-click": "nwg-displays",
        "on-click-middle": "/home/m/Dotfiles/scripts/display.sh next",
        "on-click-right": "/home/m/Dotfiles/scripts/display-restore.sh"
    },
    "custom/nightlight": {
        "exec": "/home/m/Dotfiles/scripts/nightlight.sh status",
        "return-type": "json",
        "interval": 60,
        "signal": 4,
        "on-click": "/home/m/Dotfiles/scripts/nightlight.sh toggle"
    },
    "custom/nightlight-info": {
        "exec": "/home/m/Dotfiles/scripts/nightlight.sh info",
        "return-type": "json",
        "interval": 60,
        "signal": 4,
        "on-click": "/home/m/Dotfiles/scripts/nightlight.sh toggle"
    },
    // brightness of the focused screen, or the one picked with the middle
    // click: the panel's backlight, or an external monitor over DDC/CI
    // (ddcutil), see scripts/brightness.sh
    "custom/brightness": {
        "exec": "/home/m/Dotfiles/scripts/brightness.sh status",
        "return-type": "json",
        "interval": 60,
        "signal": 6,
        "on-click-middle": "/home/m/Dotfiles/scripts/display.sh next",
        "on-scroll-up": "/home/m/Dotfiles/scripts/brightness.sh set 5%+",
        "on-scroll-down": "/home/m/Dotfiles/scripts/brightness.sh set 5%-"
    },
    "custom/brightness-info": {
        "exec": "/home/m/Dotfiles/scripts/brightness.sh info",
        "return-type": "json",
        "interval": 60,
        "signal": 6,
        "on-click-middle": "/home/m/Dotfiles/scripts/display.sh next",
        "on-scroll-up": "/home/m/Dotfiles/scripts/brightness.sh set 5%+",
        "on-scroll-down": "/home/m/Dotfiles/scripts/brightness.sh set 5%-"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂰",
        "tooltip": false,
        "on-click": "blueman-manager"
    },
    "bluetooth#info": {
        "format": "{controller_alias}",
        "format-disabled": "off",
        "format-connected": "{device_alias}",
        "format-connected-battery": "{device_alias} {device_battery_percentage}%",
        "tooltip": false,
        "on-click": "blueman-manager"
    },
    "tray": { },
    "clock": {
        "on-click" : "/home/m/Projects/calendar/build/deca",
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip": false
    },
    "clock#info": {
        "on-click" : "/home/m/Projects/calendar/build/deca",
        "format": "{:%A %d %B, week %V, day %j}",
        "tooltip": false
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 1,
        "format": "{capacity}% {icon}",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    },
    "battery#info": {
        "interval": 1,
        "format": "{time} left",
        "format-charging": "{time} to full",
        "format-plugged": "plugged in",
        "format-full": "full",
        "format-time": "{H}h {M}min",
        "tooltip": false
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip": false,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "power-profiles-daemon#info": {
        "format": "{profile}",
        "tooltip": false
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "🖧",
        "format-linked": "",
        "format-disconnected": "󰤭",
        "tooltip": false,
        "on-click": "alacritty --class impala -e impala"
    },
    "network#info": {
        "format-wifi": "{essid} {signalStrength}% ({signaldBm} dBm, {frequency} GHz)  ·  {ipaddr}/{cidr} via {gwaddr}",
        "format-ethernet": "{ifname}  ·  {ipaddr}/{cidr} via {gwaddr}",
        "format-linked": "{ifname} (no IP)",
        "format-disconnected": "disconnected",
        "tooltip": false,
        "on-click": "alacritty --class impala -e impala"
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "tooltip": false,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 2
    },
    "wireplumber#info": {
        "format": "{node_name}",
        "format-muted": "muted  ·  {node_name}",
        "tooltip": false,
        "scroll-step": 2,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": "",
        "tooltip": false,
        "on-click": "pavucontrol -t 4",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%-"
    },
    "pulseaudio#mic-info": {
        "format": "{format_source}  ·  {source_desc}",
        "format-source": "{volume}%",
        "format-source-muted": "muted",
        "tooltip": false,
        "on-click": "pavucontrol -t 4",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%-"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "pkill -x fuzzel || /home/m/Dotfiles/scripts/power-menu.sh",
        "on-click-right": "swaylock"
    },
    "custom/power-info": {
        "exec": "uptime -p",
        "interval": 60,
        "on-click": "pkill -x fuzzel || /home/m/Dotfiles/scripts/power-menu.sh",
        "on-click-right": "swaylock"
    }
}
