[global]
    timeout = 3
    gap_size = 2
    font = JetBrainsMono Nerd Font 11
    frame_width = 1
    history_length = 10

[urgency_low]
    background = "#16242d"
    foreground = "#4d86b0"
    frame_color = "#304860"
    timeout = 3

[urgency_normal]
    background = "#16242d"
    foreground = "#d6e2ee"
    frame_color = "#d6e2ee"
    timeout = 3

[urgency_critical]
    background = "#16242d"
    foreground = "#f2fcff"
    frame_color = "#4d86b0"
    timeout = 5
